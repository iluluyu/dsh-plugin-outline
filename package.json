{
  "name": "dsh-plugin-outline",
  "version": "0.2.1",
  "description": "Right-edge turn navigation for dsh web, a pixel-faithful reimplementation of chat.deepseek.com's scroll-nav: frosted dash pill, hover outline panel, click to jump",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepublishOnly": "node --check lib/index.js && node --check lib/client.js",
    "check": "node --check lib/index.js && node --check lib/client.js",
    "parity": "python3 test/make-parity.py"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iluluyu/dsh-plugin-outline.git"
  },
  "dsh": {
    "bundle": {
      "patch": "cordis.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-layout"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=1.0.0",
    "react": ">=18.0.0"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "outline",
    "navigation"
  ],
  "license": "MIT"
}
